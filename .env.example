# Public reference deployment. Never commit real credentials.
AIFINPAY_DEMO_MODE=false
AIFINPAY_WALLET_MODE=mainnet
APP_ENV=development
PORT=8787
LOG_LEVEL=info
DATABASE_URL=./data/aifinpay-local.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
MCP_PUBLIC_URL=http://localhost:8787/mcp
WIDGET_PUBLIC_URL=http://localhost:8787

# Comma-separated Polygon PoS RPC fallbacks used for read-only balances.
POLYGON_RPC_URLS=https://polygon.drpc.org,https://polygon.publicnode.com

# Comma-separated EVM networks on which the reviewed local Vault signing flow
# is enabled. Start with Polygon only; leave empty to disable all sending.
AIFINPAY_SIGNING_NETWORKS=POLYGON

# Optional Etherscan v2 key for best-effort Polygon transaction history.
ETHERSCAN_API_KEY=

# Optional per-network RPC overrides for read-only balances across all 13
# mainnet networks. Each is comma-separated and falls back to the public
# defaults baked into the app when left blank. Non-EVM networks (Solana, NEAR,
# Aptos, Casper) use their respective JSON-RPC / REST endpoints.
AVALANCHE_RPC_URLS=
ARBITRUM_RPC_URLS=
BNB_RPC_URLS=
BASE_RPC_URLS=
UNICHAIN_RPC_URLS=
OPTIMISM_RPC_URLS=
BOTCHAIN_RPC_URLS=
XRPLEVM_RPC_URLS=
SOLANA_RPC_URLS=
NEAR_RPC_URLS=
APTOS_RPC_URLS=
CASPER_RPC_URLS=https://node.mainnet.casper.network/rpc

# The public Casper mainnet node above needs no key. For the faster cspr.cloud
# provider, set CASPER_RPC_URLS=https://node.cspr.cloud/rpc and put its API key
# below; the value is sent verbatim as the Authorization header.
CASPER_RPC_AUTH=

# ChangeNOW partner API key. Required for live cross-chain swap quotes and
# orders. It is used server-side only and is never sent to ChatGPT or the widget.
CHANGENOW_API_KEY=

# Render sets RENDER_EXTERNAL_HOSTNAME automatically; do not add it by hand.

# Optional private operator integrations. Never commit their values.
AIFINPAY_API_BASE_URL=
AIFINPAY_API_KEY=

# Optional production/model integration. The MCP app itself does not require it.
OPENAI_API_KEY=

# Optional explicit demo/testnet adapter placeholders.
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=80002
POLYGON_USDC_ADDRESS=
BLOCK_EXPLORER_BASE_URL=https://amoy.polygonscan.com
