# Public reference deployment. Never commit real credentials.
AIFINPAY_DEMO_MODE=false
AIFINPAY_WALLET_MODE=mainnet
APP_ENV=development
PORT=8787
LOG_LEVEL=info
DATABASE_URL=./data/aifinpay-local.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
MCP_PUBLIC_URL=http://localhost:8787/mcp
WIDGET_PUBLIC_URL=http://localhost:8787

# Comma-separated Polygon PoS RPC fallbacks.
POLYGON_RPC_URLS=https://polygon.drpc.org,https://polygon.publicnode.com

# Explicit send allowlist. Direct local signing is implemented for seven primary
# EVM mainnets plus native SOL, NEAR and APT. BOTCHAIN/XRPLEVM remain locked
# pending live fee/broadcast proof. Casper remains receive-only until its canonical
# deploy serializer and validator pass production tests.
AIFINPAY_SIGNING_NETWORKS=POLYGON,AVALANCHE,ARBITRUM,BNB,BASE,UNICHAIN,OPTIMISM,SOLANA,NEAR,APTOS

# Optional Etherscan v2 key for best-effort Polygon transaction history.
ETHERSCAN_API_KEY=

# Optional per-network RPC overrides. Each value is comma-separated and falls
# back to the public defaults in the application when blank.
AVALANCHE_RPC_URLS=
ARBITRUM_RPC_URLS=
BNB_RPC_URLS=
BASE_RPC_URLS=
UNICHAIN_RPC_URLS=
OPTIMISM_RPC_URLS=
BOTCHAIN_RPC_URLS=
XRPLEVM_RPC_URLS=
SOLANA_RPC_URLS=
NEAR_RPC_URLS=
APTOS_RPC_URLS=
CASPER_RPC_URLS=https://node.mainnet.casper.network/rpc

# Optional Authorization headers for keyed providers.
AVALANCHE_RPC_AUTH=
ARBITRUM_RPC_AUTH=
BNB_RPC_AUTH=
BASE_RPC_AUTH=
UNICHAIN_RPC_AUTH=
OPTIMISM_RPC_AUTH=
BOTCHAIN_RPC_AUTH=
XRPLEVM_RPC_AUTH=
SOLANA_RPC_AUTH=
NEAR_RPC_AUTH=
APTOS_RPC_AUTH=

# The public Casper mainnet node needs no key. For cspr.cloud, change the URL and
# store the provider credential here; it is sent verbatim as Authorization.
CASPER_RPC_AUTH=

# ChangeNOW partner API key. Required for live cross-chain swap quotes and orders.
CHANGENOW_API_KEY=

# Render sets RENDER_EXTERNAL_HOSTNAME automatically.

# Optional private operator integrations. Never commit their values.
AIFINPAY_API_BASE_URL=
AIFINPAY_API_KEY=

# Optional model integration. The MCP wallet itself does not require it.
OPENAI_API_KEY=

# Optional demo/testnet adapter placeholders.
POLYGON_RPC_URL=
POLYGON_CHAIN_ID=80002
POLYGON_USDC_ADDRESS=
BLOCK_EXPLORER_BASE_URL=https://amoy.polygonscan.com
